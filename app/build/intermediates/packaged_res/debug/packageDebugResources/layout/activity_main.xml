<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page"
    android:padding="16dp">

    <!-- Top App Branding Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✈️"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/bg_hero_card"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PocketPilot"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BBSUTSD Khairpur Mirs"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAboutProject"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="ℹ️"
            android:textSize="15sp"
            android:backgroundTint="#E2E8F0"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Hero Balance Overview Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/bg_hero_card"
        android:elevation="4dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TOTAL VIRTUAL BALANCE"
            android:textSize="11sp"
            android:textColor="#DBEAFE"
            android:letterSpacing="0.08"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rs. 0.00"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Income Container -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_box"
                android:padding="12dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Total Income"
                    android:textSize="11sp"
                    android:textColor="#A7F3D0"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtIncome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Rs. 0.00"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Expense Container -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_box"
                android:padding="12dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴 Total Expense"
                    android:textSize="11sp"
                    android:textColor="#FCA5A5"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtExpense"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- Rs. 0.00"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Navigation Quick Action Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnAddTransaction"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="+ Transaction"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#2563EB"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnBudgets"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="📊 Budgets"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#4F46E5"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnSavingsGoals"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="🎯 Savings Goals"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#059669"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnExportCsv"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="📁 Export CSV"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#334155"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- Filter Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:background="@drawable/bg_card_elevated"
        android:padding="8dp"
        android:layout_marginBottom="12dp">

        <Spinner
            android:id="@+id/spinnerFilterType"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/spinnerFilterCategory"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- History Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recent Transactions"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp" />

    <!-- Empty State View -->
    <TextView
        android:id="@+id/txtNoTransactions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💸 No transactions found matching the filter.\nTap '+ Transaction' above to add one!"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:padding="32dp"
        android:background="@drawable/bg_card_elevated"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listViewTransactions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp" />

</LinearLayout>
