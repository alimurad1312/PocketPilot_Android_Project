<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_elevated"
    android:elevation="2dp">

    <!-- Category Icon Avatar Container -->
    <TextView
        android:id="@+id/txtItemIconAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:text="🍔"
        android:textSize="22sp"
        android:gravity="center"
        android:background="@drawable/bg_category_food"
        android:layout_marginEnd="12dp" />

    <!-- Details Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtItemCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/txtItemTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Expense"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#EF4444"
                android:background="@drawable/bg_expense_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtItemDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lunch at cafeteria"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/txtItemDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-11-16"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Amount & Actions Column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/txtItemAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="- Rs. 250.00"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#EF4444" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnItemEdit"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Edit"
                android:textSize="10sp"
                android:textStyle="bold"
                android:backgroundTint="#4F46E5"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnItemDelete"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:layout_marginStart="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Delete"
                android:textSize="10sp"
                android:textStyle="bold"
                android:backgroundTint="#EF4444"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
