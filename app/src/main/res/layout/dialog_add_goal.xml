<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_page">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Goal Name"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/dialogEditGoalName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="e.g. Laptop, Course Books"
        android:textSize="14sp"
        android:background="@drawable/bg_input_field"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Target Amount (Rs.)"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/dialogEditGoalTarget"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:inputType="numberDecimal"
        android:hint="e.g. 50000"
        android:textSize="14sp"
        android:background="@drawable/bg_input_field"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Initial Saved Amount (Optional Rs.)"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/dialogEditGoalInitial"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:inputType="numberDecimal"
        android:hint="0"
        android:textSize="14sp"
        android:background="@drawable/bg_input_field"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Target Date (Tap to Pick 📅)"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/dialogEditGoalDate"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:focusable="false"
        android:clickable="true"
        android:hint="Select date"
        android:textSize="14sp"
        android:background="@drawable/bg_input_field"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="6dp" />

</LinearLayout>
